#!/usr/bin/env bash
# rpi64 — Raspberry Pi CM4/CM5 64-bit configuration (Bookworm)
# Deterministic config file: defines and exports variables only (no side effects).
# Place at ratos/config/raspberry/rpi64 and commit to repo branch 2.1.0.

set -euo pipefail

# Board identification
BOARD_NAME="raspberrypi-cm5"
BOARD_VARIANT="bookworm-lite"
BOARD_ARCH="aarch64"        # CPU architecture label for scripts that expect aarch64
DEBOOTSTRAP_ARCH="arm64"    # architecture used by debootstrap/apt
BASE_ARCH="arm64"           # base architecture used across the build

# QEMU static binary path used for chroot/emulation (ensure installed on runner)
QEMU_BINARY="/usr/bin/qemu-aarch64-static"

# Image download URLs (keep these static so file hash is stable)
# Update these URLs manually if upstream changes; do not compute them dynamically.
DOWNLOAD_URL_CHECKSUM="https://downloads.raspberrypi.org/raspios_oldstable_lite_arm64/images/raspios_oldstable_lite_arm64-2025-11-24/2025-11-24-raspios-bookworm-arm64-lite.img.xz.sha256"
DOWNLOAD_URL_IMAGE="https://downloads.raspberrypi.org/raspios_oldstable_lite_arm64/images/raspios_oldstable_lite_arm64-2025-11-24/2025-11-24-raspios-bookworm-arm64-lite.img.xz.torrent"

# Local filenames (optional defaults used by build scripts)
IMAGE_FILENAME="raspios-bookworm-arm64-lite.img.xz"
CHECKSUM_FILENAME="raspios-bookworm-arm64-lite.img.xz.sha256"

# Export everything so scripts that source this file can read them
export BOARD_NAME
export BOARD_VARIANT
export BOARD_ARCH
export DEBOOTSTRAP_ARCH
export BASE_ARCH
export QEMU_BINARY
export DOWNLOAD_URL_CHECKSUM
export DOWNLOAD_URL_IMAGE
export IMAGE_FILENAME
export CHECKSUM_FILENAME

# When executed directly, print the configuration (harmless, no side effects)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  cat <<EOF
rpi64 configuration
--------------------
BOARD_NAME:        $BOARD_NAME
BOARD_VARIANT:     $BOARD_VARIANT
BOARD_ARCH:        $BOARD_ARCH
DEBOOTSTRAP_ARCH:  $DEBOOTSTRAP_ARCH
BASE_ARCH:         $BASE_ARCH
QEMU_BINARY:       $QEMU_BINARY
DOWNLOAD_CHECKSUM: $DOWNLOAD_URL_CHECKSUM
DOWNLOAD_IMAGE:    $DOWNLOAD_URL_IMAGE
IMAGE_FILENAME:    $IMAGE_FILENAME
CHECKSUM_FILENAME: $CHECKSUM_FILENAME
EOF
fi
