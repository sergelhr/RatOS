
[Unit]
Description=RatOS automatic Wi-Fi hotspot (NetworkManager)
Documentation=https://github.com/RaspberryConnect/AccessPopup
Wants=NetworkManager.service
After=NetworkManager.service network-pre.target
Before=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/autohotspotN --daemon
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
