#!/usr/bin/env bash
set -uo pipefail

CONFIG=/etc/ratos/hotspot.conf
[[ -r "$CONFIG" ]] && source "$CONFIG"
: "${HOTSPOT_NAME:=RatOS}"
: "${HOTSPOT_PASSWORD:=raspberry}"
: "${HOTSPOT_CHANNEL:=6}"
: "${HOTSPOT_ADDRESS:=192.168.50.1/24}"
: "${HOTSPOT_CHECK_INTERVAL:=30}"
: "${HOTSPOT_INTERFACE:=wlan0}"
: "${HOTSPOT_PROFILE:=RatOS-Hotspot}"

log(){ logger -t ratos-hotspot -- "$*"; echo "ratos-hotspot: $*"; }
nm(){ nmcli --wait 15 "$@"; }

wifi_ready(){ nm -t -f GENERAL.STATE device show "$HOTSPOT_INTERFACE" >/dev/null 2>&1; }
active_profile(){ nm -t -f GENERAL.CONNECTION device show "$HOTSPOT_INTERFACE" 2>/dev/null | cut -d: -f2-; }
connected_to_wifi(){
  local p
  p="$(active_profile)"
  [[ -n "$p" && "$p" != "--" && "$p" != "$HOTSPOT_PROFILE" ]]
}
known_wifi_available(){
  local ssid
  nm device wifi rescan ifname "$HOTSPOT_INTERFACE" >/dev/null 2>&1 || true
  while IFS= read -r ssid; do
    [[ -n "$ssid" ]] || continue
    nm -t -f NAME,TYPE connection show | grep -Fqx "$ssid:802-11-wireless" && return 0
  done < <(nm -t -f SSID device wifi list ifname "$HOTSPOT_INTERFACE" 2>/dev/null | sed '/^$/d' | sort -u)
  return 1
}
connect_known_wifi(){
  local ssid
  while IFS= read -r ssid; do
    [[ -n "$ssid" ]] || continue
    if nm -t -f NAME,TYPE connection show | grep -Fqx "$ssid:802-11-wireless"; then
      nm connection up id "$ssid" ifname "$HOTSPOT_INTERFACE" >/dev/null 2>&1 && return 0
    fi
  done < <(nm -t -f IN-USE,SIGNAL,SSID device wifi list ifname "$HOTSPOT_INTERFACE" 2>/dev/null | sort -t: -k2,2nr | cut -d: -f3- | sed '/^$/d')
  return 1
}
create_profile(){
  nm connection delete "$HOTSPOT_PROFILE" >/dev/null 2>&1 || true
  nm connection add type wifi ifname "$HOTSPOT_INTERFACE" con-name "$HOTSPOT_PROFILE" ssid "$HOTSPOT_NAME" >/dev/null
  nm connection modify "$HOTSPOT_PROFILE" \
    802-11-wireless.mode ap \
    802-11-wireless.band bg \
    802-11-wireless.channel "$HOTSPOT_CHANNEL" \
    802-11-wireless.powersave 2 \
    wifi-sec.key-mgmt wpa-psk \
    wifi-sec.psk "$HOTSPOT_PASSWORD" \
    ipv4.method shared \
    ipv4.addresses "$HOTSPOT_ADDRESS" \
    ipv6.method disabled \
    connection.autoconnect no \
    connection.permissions ''
}
start_hotspot(){
  [[ "$(active_profile)" == "$HOTSPOT_PROFILE" ]] && return 0
  nm radio wifi on >/dev/null 2>&1 || true
  nm connection show "$HOTSPOT_PROFILE" >/dev/null 2>&1 || create_profile
  if nm connection up "$HOTSPOT_PROFILE" ifname "$HOTSPOT_INTERFACE" >/dev/null; then
    log "hotspot active: SSID=$HOTSPOT_NAME address=${HOTSPOT_ADDRESS%/*}"
    return 0
  fi
  log "failed to activate hotspot"
  return 1
}
stop_hotspot(){ nm connection down "$HOTSPOT_PROFILE" >/dev/null 2>&1 || true; }
auto_once(){
  rfkill unblock wifi 2>/dev/null || true
  nm radio wifi on >/dev/null 2>&1 || true
  wifi_ready || { log "interface $HOTSPOT_INTERFACE unavailable"; return 1; }
  connected_to_wifi && return 0
  if known_wifi_available; then
    stop_hotspot
    connect_known_wifi && { log "connected to known Wi-Fi"; return 0; }
  fi
  start_hotspot
}
usage(){ echo "Usage: autohotspotN [--daemon|--once|--ap|--wifi|--status]"; }
case "${1:---once}" in
  --daemon) while true; do auto_once || true; sleep "$HOTSPOT_CHECK_INTERVAL"; done ;;
  --once) auto_once ;;
  --ap|-a) stop_hotspot; start_hotspot ;;
  --wifi|-w) stop_hotspot; nm device wifi rescan ifname "$HOTSPOT_INTERFACE" >/dev/null 2>&1 || true; connect_known_wifi ;;
  --status) nm device status; nm connection show --active ;;
  *) usage; exit 2 ;;
esac
