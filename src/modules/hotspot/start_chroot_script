#!/usr/bin/env bash
set -euxo pipefail
source /common.sh

export DEBIAN_FRONTEND=noninteractive
apt-get update --allow-releaseinfo-change
apt-get install -y --no-install-recommends network-manager iw rfkill

# Remove the legacy backend. hostapd conflicts with NetworkManager AP mode.
systemctl disable hostapd.service dnsmasq.service autohotspot.service 2>/dev/null || true
apt-get purge -y hostapd dnsmasq dnsmasq-base 2>/dev/null || true

unpack /filesystem/root /

install -d -m 0755 /etc/ratos
cat > /etc/ratos/hotspot.conf <<CONFIG
HOTSPOT_NAME='${HOTSPOT_NAME}'
HOTSPOT_PASSWORD='${HOTSPOT_PASSWORD}'
HOTSPOT_CHANNEL='${HOTSPOT_CHANNEL}'
HOTSPOT_ADDRESS='${HOTSPOT_ADDRESS}'
HOTSPOT_CHECK_INTERVAL='${HOTSPOT_CHECK_INTERVAL}'
HOTSPOT_INTERFACE='wlan0'
HOTSPOT_PROFILE='RatOS-Hotspot'
CONFIG
chmod 0600 /etc/ratos/hotspot.conf

chmod 0755 /usr/bin/autohotspotN /usr/bin/ratos-hotspot
systemctl enable NetworkManager.service
systemctl enable autohotspot.service
