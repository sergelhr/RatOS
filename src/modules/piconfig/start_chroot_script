#!/usr/bin/env bash
# Preinstall customised Raspberry Pi / RatOS configuration
# Debian 13 (Trixie) compatible revision

# shellcheck enable=require-variable-braces

set -Eex

if [[ "${DEBIAN_FRONTEND:-}" != "noninteractive" ]]; then
    export DEBIAN_FRONTEND=noninteractive
fi

# CustomPiOS common helpers
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

# Validate required variables early.
: "${PICONFIG_CONFIG_TXT_FILE:?PICONFIG_CONFIG_TXT_FILE is not set}"
: "${PICONFIG_CONFIG_BAK_FILE:?PICONFIG_CONFIG_BAK_FILE is not set}"
: "${PICONFIG_CMDLINE_TXT_FILE:?PICONFIG_CMDLINE_TXT_FILE is not set}"
: "${PICONFIG_CMDLINE_BAK_FILE:?PICONFIG_CMDLINE_BAK_FILE is not set}"
: "${BASE_USER:?BASE_USER is not set}"

# Trixie/Bookworm Raspberry Pi OS normally uses /boot/firmware.
# Keep the framework-provided paths, but warn about an old /boot/config.txt target.
if [[ "${PICONFIG_CONFIG_TXT_FILE}" == "/boot/config.txt" && -d /boot/firmware ]]; then
    echo_red "WARNING: PICONFIG_CONFIG_TXT_FILE points to /boot/config.txt; Trixie normally uses /boot/firmware/config.txt"
fi

# Step 1: Copy msos_config.txt
echo_green "Copying temporary file ..."
unpack /filesystem/tmp /tmp root

if [[ ! -f /tmp/msos_config.txt ]]; then
    echo_red "Missing required file: /tmp/msos_config.txt"
    exit 1
fi

echo_green "Merge RatOS configuration with default config.txt ..."

install -d -m 0755 "$(dirname "${PICONFIG_CONFIG_TXT_FILE}")"

if [[ ! -f "${PICONFIG_CONFIG_TXT_FILE}" ]]; then
    echo_red "Default config.txt not found. Creating an empty one ..."
    : >"${PICONFIG_CONFIG_TXT_FILE}"
fi

cp -- "${PICONFIG_CONFIG_TXT_FILE}" /tmp/config.txt
cp -- "${PICONFIG_CONFIG_TXT_FILE}" "${PICONFIG_CONFIG_BAK_FILE}"

# Do not force FKMS on Trixie. vc4-fkms-v3d is a legacy display path.
# An optional compatibility switch can disable full KMS for a specifically
# tested legacy display, but it does not automatically enable FKMS.
if [[ "${PICONFIG_DISABLE_KMS:-0}" == "1" ]]; then
    echo_green "Disabling vc4-kms-v3d for a legacy display override ..."
    sed -Ei 's/^[[:space:]]*(dtoverlay=vc4-kms-v3d.*)$/#\1/' /tmp/config.txt
fi

cat /tmp/config.txt /tmp/msos_config.txt > /tmp/config.new
install -m 0644 /tmp/config.new "${PICONFIG_CONFIG_TXT_FILE}"

rm -f /tmp/config.txt /tmp/config.new /tmp/msos_config.txt

# Step 2: Back up and update cmdline.txt
install -d -m 0755 "$(dirname "${PICONFIG_CMDLINE_TXT_FILE}")"

if [[ ! -f "${PICONFIG_CMDLINE_TXT_FILE}" ]]; then
    echo_red "Default cmdline.txt not found. Creating an empty one ..."
    : >"${PICONFIG_CMDLINE_TXT_FILE}"
fi

cp -- "${PICONFIG_CMDLINE_TXT_FILE}" "${PICONFIG_CMDLINE_BAK_FILE}"

echo_green "Disabling the serial Linux console ..."
# Remove common Raspberry Pi serial-console forms without disturbing other args.
sed -Ei \
    -e 's/(^|[[:space:]])console=(serial0|ttyAMA0|ttyS0),[0-9]+([[:space:]]|$)/ /g' \
    -e 's/[[:space:]]+/ /g' \
    -e 's/^ //; s/ $//' \
    "${PICONFIG_CMDLINE_TXT_FILE}"

# Step 3: Enable I2C userspace support
echo_green "Enabling i2c-dev ..."
[[ -f /etc/modules ]] || : >/etc/modules

# Legacy blacklist handling is retained only when the old file exists.
if [[ -f /etc/modprobe.d/raspi-blacklist.conf ]]; then
    sed -Ei 's/^[[:space:]]*blacklist[[:space:]]+i2c[-_]bcm2708/# &/' \
        /etc/modprobe.d/raspi-blacklist.conf
fi

sed -Ei 's/^[[:space:]]*#[[:space:]]*(i2c[-_]dev)[[:space:]]*$/\1/' /etc/modules
if ! grep -Eq '^[[:space:]]*i2c[-_]dev([[:space:]]|$)' /etc/modules; then
    printf '%s\n' 'i2c-dev' >>/etc/modules
fi

check_install_pkgs i2c-tools

# Step 4: Disable Bluetooth services when present
echo_green "Disabling Bluetooth-related services ..."
systemctl_if_exists disable hciuart.service
systemctl_if_exists disable bluetooth.service
systemctl_if_exists disable bluealsa.service

# Step 5: Configure dphys-swapfile when installed/configured
if [[ -n "${PICONFIG_SWAP_CONF_FILE:-}" && -f "${PICONFIG_SWAP_CONF_FILE}" ]]; then
    : "${PICONFIG_SWAP_SIZE:?PICONFIG_SWAP_SIZE is not set}"
    : "${PICONFIG_SWAP_MAX:?PICONFIG_SWAP_MAX is not set}"

    echo_green "Setting swap file size to ${PICONFIG_SWAP_SIZE} MiB, maximum ${PICONFIG_SWAP_MAX} MiB ..."

    if grep -q '^CONF_SWAPSIZE=' "${PICONFIG_SWAP_CONF_FILE}"; then
        sed -Ei "s/^CONF_SWAPSIZE=.*/CONF_SWAPSIZE=${PICONFIG_SWAP_SIZE}/" "${PICONFIG_SWAP_CONF_FILE}"
    else
        printf 'CONF_SWAPSIZE=%s\n' "${PICONFIG_SWAP_SIZE}" >>"${PICONFIG_SWAP_CONF_FILE}"
    fi

    if grep -Eq '^#?CONF_MAXSWAP=' "${PICONFIG_SWAP_CONF_FILE}"; then
        sed -Ei "s/^#?CONF_MAXSWAP=.*/CONF_MAXSWAP=${PICONFIG_SWAP_MAX}/" "${PICONFIG_SWAP_CONF_FILE}"
    else
        printf 'CONF_MAXSWAP=%s\n' "${PICONFIG_SWAP_MAX}" >>"${PICONFIG_SWAP_CONF_FILE}"
    fi
fi

# Step 6: Enable tty1 console autologin
echo_green "Enabling console autologin for ${BASE_USER} ..."

if ! getent passwd "${BASE_USER}" >/dev/null; then
    echo_red "Autologin user does not exist: ${BASE_USER}"
    exit 1
fi

AGETTY_PATH="$(command -v agetty || true)"
if [[ -z "${AGETTY_PATH}" ]]; then
    echo_red "agetty is not installed"
    exit 1
fi

systemctl set-default multi-user.target
install -d -m 0755 /etc/systemd/system/getty@tty1.service.d

cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<EOF_AUTOLOGIN
[Service]
ExecStart=
ExecStart=-${AGETTY_PATH} --autologin ${BASE_USER} --noclear %I \$TERM
EOF_AUTOLOGIN

systemctl enable getty@tty1.service

# daemon-reload can fail or be unnecessary in some image-build chroots.
# The drop-in is read normally on first boot.
systemctl daemon-reload || true

# Step 7: Configure locale without depending exclusively on raspi-config
echo_green "Generating and setting default locale to en_US.UTF-8 ..."
check_install_pkgs locales

if [[ -f /etc/locale.gen ]]; then
    sed -Ei 's/^[[:space:]]*#[[:space:]]*(en_US.UTF-8[[:space:]]+UTF-8)/\1/' /etc/locale.gen
    if ! grep -Eq '^[[:space:]]*en_US.UTF-8[[:space:]]+UTF-8' /etc/locale.gen; then
        printf '%s\n' 'en_US.UTF-8 UTF-8' >>/etc/locale.gen
    fi
fi

locale-gen en_US.UTF-8
update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
